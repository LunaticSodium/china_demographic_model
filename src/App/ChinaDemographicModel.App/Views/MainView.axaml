<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChinaDemographicModel.App.ViewModels"
             xmlns:views="using:ChinaDemographicModel.App.Views"
             xmlns:controls="using:ChinaDemographicModel.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="920"
             x:CompileBindings="False"
             x:Class="ChinaDemographicModel.App.Views.MainView">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- 响应式：宽屏三栏；窄屏（手机）折叠为单栏 + 标签页，见 code-behind ApplyLayout。 -->
    <Border Background="{StaticResource BgBaseBrush}">
        <Grid x:Name="RootGrid" Margin="20" RowDefinitions="Auto,*">

            <!-- 顶部条 -->
            <Border Grid.Row="0" Classes="card" Margin="0,0,0,16" Padding="20,14">
                <Grid x:Name="TopBar" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel x:Name="TitleBlock" Grid.Column="0" Grid.Row="0" Orientation="Vertical">
                        <TextBlock Text="中国人口结构 · 工作台" Classes="title"/>
                        <TextBlock x:Name="Subtitle"
                                   Text="Cohort-Component projection · 历史一致性约束 · 反事实推演"
                                   Classes="subtitle" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid x:Name="SliderHost" Grid.Column="1" Grid.Row="0" Margin="20,0,16,0"
                          VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                        <StackPanel x:Name="LegendPanel" Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,4,0" Background="{StaticResource BgElevBrush}"/>
                            <TextBlock Text="一般" Classes="subtitle" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,4,0" Background="{StaticResource CensusBrush}"/>
                            <TextBlock Text="普查" Classes="subtitle" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,4,0" Background="{StaticResource ForecastBrush}"/>
                            <TextBlock Text="预测" Classes="subtitle" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,4,0" Background="{StaticResource WarnBrush}"/>
                            <TextBlock Text="反事实" Classes="subtitle" VerticalAlignment="Center"/>
                        </StackPanel>
                        <controls:YearSlider x:Name="YearSliderCtl" Grid.Column="1"
                                             Minimum="{Binding YearMin}"
                                             Maximum="{Binding YearMax}"
                                             Value="{Binding CurrentYear, Mode=TwoWay}"
                                             CensusYears="{Binding CensusYears}"
                                             LastObservedYear="{Binding LastObservedYear}"
                                             IsCounterfactual="{Binding IsCounterfactualScenario}"
                                             MinWidth="500" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding CurrentYear}" Classes="accent"
                                   FontSize="26" FontWeight="Light" MinWidth="68" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel x:Name="TopButtons" Grid.Column="2" Grid.Row="0"
                                Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↺ 重置基线" Classes="ghost" Command="{Binding ResetScenarioCommand}" Margin="0,0,8,0"/>
                        <Button Content="▶ 重跑投影" Classes="primary" Command="{Binding RunProjectionCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主区 -->
            <Grid x:Name="MainArea" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <views:ControlsPanel x:Name="LeftPanel" Grid.Column="0" Margin="0,0,16,0"/>

                <Border Grid.Column="1" Classes="card" Padding="20">
                    <TabControl>
                        <TabItem Header="人口金字塔"><views:PyramidView/></TabItem>
                        <TabItem Header="时间序列"><views:TimeSeriesView/></TabItem>
                        <TabItem Header="输入编辑"><views:InputsEditorView/></TabItem>
                        <!-- 窄屏时才出现：把左右栏收进标签页 -->
                        <TabItem x:Name="NarrowControlsTab" Header="设置" IsVisible="False">
                            <views:ControlsPanel ShowActions="True"/>
                        </TabItem>
                        <TabItem x:Name="NarrowMetricsTab" Header="指标" IsVisible="False">
                            <views:MetricsPanel/>
                        </TabItem>
                    </TabControl>
                </Border>

                <views:MetricsPanel x:Name="RightPanel" Grid.Column="2" Margin="16,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
