<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ChinaDemographicModel.App"
             xmlns:conv="using:ChinaDemographicModel.App.Converters"
             x:Class="ChinaDemographicModel.App.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ChinaDemographicModel.App/Themes/Tokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:EnumToBoolConverter x:Key="EnumToBool"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ChinaDemographicModel.App/Themes/AppStyles.axaml"/>
    </Application.Styles>
</Application>
